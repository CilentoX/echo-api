# Echo API — Variáveis de Ambiente
# Copie para .env e preencha os valores

# Servidor
PORT=3001
NODE_ENV=production

# PostgreSQL — String de conexão completa (para Prisma e DBeaver)
# Formato: postgresql://usuario:senha@host:porta/banco?schema=public
DATABASE_URL="postgresql://echo_api:sua_senha_aqui@echo-postgres:5432/echo_profiles?schema=public"

# Para acesso externo via DBeaver (sua máquina → VPS):
# Host: IP da VPS
# Porta: 5432
# Banco: echo_profiles
# Usuário: echo_api
# Senha: sua_senha_aqui

# Segurança
API_KEY=sua_chave_api_aqui

# Upload
UPLOAD_DIR=./src/uploads
MAX_FILE_SIZE=10485760

# URLs públicas
PUBLIC_BASE_URL=https://api.echo.litteris.online
