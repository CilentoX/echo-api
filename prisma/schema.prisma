/// Prisma schema for Echo API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserToken {
  userId       String   @unique
  accessToken  String   // encrypted
  refreshToken String?  // encrypted
  deviceId     String?
  updatedAt    DateTime @updatedAt
}

model UserProfile {
  userId    String  @unique
  nickname  String? @unique
  avatarUrl String?
  bannerUrl String?
  bio       String?
  links     Json    @default("[]")
}

model ChatMedia {
  mediaId       String   @unique
  userId        String
  roomId        String?
  filePath      String
  fileType      String   // e.g., "image", "audio"
  mimeType      String
  fileSize      Int?
  width         Int?
  height        Int?
  duration      Int?
  synapseMxcUri String?
  createdAt     DateTime @default(now())
}

model GuildProfile {
  guildId       String   @unique
  matrixSpaceId String?  @unique
  name          String?
  description   String?
  topic         String?
  avatarUrl     String?
  bannerUrl     String?
  createdBy     String?
  isPrivate     Boolean  @default(false)
  maxMembers    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  channels      ChannelProfile[]
  invites       GuildInvite[]
}

model ChannelProfile {
  id           String   @id @default(cuid())
  guildId      String
  matrixRoomId String   @unique
  name         String
  topic        String?
  type         String   @default("text")
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild        GuildProfile @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model GuildInvite {
  id        String       @id @default(cuid())
  code      String       @unique
  guildId   String
  creatorId String
  maxUses   Int?
  usesCount Int          @default(0)
  expiresAt DateTime?
  createdAt DateTime     @default(now())

  guild     GuildProfile @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([code])
  @@index([guildId])
}

model Friendship {
  id           String   @id @default(cuid())
  requesterId  String   // Matrix User ID do usuário que enviou a solicitação
  addresseeId  String   // Matrix User ID do usuário que recebeu a solicitação
  status       String   @default("pending") // "pending" | "accepted" | "declined" | "blocked"
  blockedById  String?  // Matrix User ID de quem executou o bloqueio (quando status === "blocked")
  directRoomId String?  // ID da sala Matrix 1-a-1 direta (ex: "!dm_123:litteris.online")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

